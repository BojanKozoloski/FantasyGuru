@model FantasyGuru.Models.LeagueStandings
@{
    ViewBag.Title = "LeagueC";
    Layout = null;
}

<style>

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: #0A3099;
        color: #999;
        font-family: Arial, sans-serif;
    }

    thead {
        background-color: #061D5E;
    }

    th {
        color: #00b86b;
        text-transform: uppercase;
        font-weight: 500;
        text-align: left;
        padding: 18px 36px;
    }

    td {
        padding: 14px 36px;
        border: none;
        color: #999;
    }

    tr {
        border: none;
    }
    .container::-webkit-scrollbar {
        width: 9px;
    }
    .container::-webkit-scrollbar-track {
        background: #333;
    }
    .container::-webkit-scrollbar-thumb {
        background: #00b86b;
        border-radius: 10px;
    }
    .container {
        max-height: 580px;
        overflow-y: auto;
        border-radius: 10px;
    }
    .compare
    {
        color: black;
    }

</style>



<h2>League</h2>

<h1>@Model.league.Name</h1>
<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Manager</th>
                <th>Team Name</th>
                <th>Points</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.standings.results)
            {
                <tr>
                    <td>@result.rank</td>
                    <td>@result.player_name</td>
                    <td>@result.entry_name</td>
                    <td>@result.total</td>
                    <td class="compare">
                        @Html.ActionLink("Compare", "Compare", "Manager",
                            new { myid = ViewBag.ManagerId, oppid = result.entry }, null)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>