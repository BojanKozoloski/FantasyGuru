@{
    int myTotal = Model.Me.summary_overall_points ?? 0;
    int oppTotal = Model.Opponent.summary_overall_points ?? 0;
    int totalDifference = myTotal - oppTotal;
    int gwDifference = Model.MyGameweekPoints - Model.OpponentGameweekPoints;
}

<div class="scoreboard" onclick="toggleScoreboard(this)"
     data-total-diff="@totalDifference"
     data-gw-diff="@gwDifference"
     data-showing="total">

    <div class="scoreboard-title" id="scoreboardTitle">Points Difference</div>

    <div class="scoreboard-difference @(totalDifference > 0 ? "positive" : totalDifference < 0 ? "negative" : "equal")"
         id="scoreboardValue">
        @if (totalDifference > 0)
        {
            <span>↑ @totalDifference</span>
        }
        else if (totalDifference < 0)
        {
            <span>↓ @Math.Abs(totalDifference)</span>
        }
        else
        {
            <span>0</span>
        }
    </div>

    <div class="scoreboard-label">You vs Opponent</div>
</div>


<div class="pitch">
    <div class="team my-team">

        @{
            var myStarters = Model.MyUniquePlayers
            .Where(p => p.position >= 1 && p.position <= 11);

            var myGroups = myStarters.GroupBy(p => p.element_type);
        }
        @foreach (var group in myGroups)
        {
            var playersInRow = group.ToList();
            var count = playersInRow.Count;

            for (int i = 0; i < count; i++)
            {

                var p = playersInRow[i];
                double topPercent = (104.0 / (count + 1)) * (i + 1);

                <div class="player position-@p.element_type" style="top:@topPercent%">

                    <div class="player-card" onclick="togglePoints(this)">

                        <div class="jersey">

                            <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@p.team_code-66.png" alt="@p.web_name" />

                        </div>

                        <div class="player-info">
                            <span class="player-name">
                                @p.web_name
                            </span>

                            <span class="player-points" data-event-points="@p.event_points"
                                  data-total-points="@p.total_points">
                                @p.event_points pts
                            </span>
                        </div>

                    </div>
                </div>
            }
        }
    </div>


    <div class="team opponent-team">

        @{
            var oppStarters = Model.OpponentUniquePlayers
        .Where(p => p.position >= 1 && p.position <= 11);

            var oppGroups = oppStarters.GroupBy(p => p.element_type);
        }
        @foreach (var group in oppGroups)
        {
            var playersInRow = group.ToList();
            var count = playersInRow.Count;
            for (int i = 0; i < count; i++)
            {
                var p = playersInRow[i];
                double topPercent = (104.0 / (count + 1)) * (i + 1);
                <div class="player position-@p.element_type" style="top:@topPercent%">


                    <div class="player-card" onclick="togglePoints(this)">

                        <div class="jersey">

                            <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@p.team_code-66.png" alt="@p.web_name" />

                        </div>

                        <div class="player-info">
                            <span class="player-name">
                                @p.web_name
                            </span>

                            <span class="player-points" data-event-points="@p.event_points"
                                  data-total-points="@p.total_points">
                                @p.event_points pts
                            </span>
                        </div>

                    </div>
                </div>
            }
        }
    </div>

</div>


<div class="bench opponent-bench">
    <h4>Bench (different)</h4>
    @{
        var oppBench = Model.OpponentUniquePlayers.Where(p => p.position >= 12 && p.position <= 15)
                                                   .OrderBy(p => p.element_type == 1 ? 0 : 1)
                                                   .ThenBy(p => p.position);
    }
    @foreach (var p in oppBench)
    {
        <div class="bench-card" onclick="togglePoints(this)">
            <div class="jersey">
                <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@p.team_code-66.png" alt="@p.web_name" />
            </div>
            <div class="player-info">
                <span class="player-name">@p.web_name</span>
                <span class="player-points" data-event-points="@p.event_points" data-total-points="@p.total_points">
                    @p.event_points pts
                </span>
            </div>
        </div>
    }
</div>

<div class="bench my-bench">
    <h4>Bench (different)</h4>
    @{
        var myBench = Model.MyUniquePlayers.Where(p => p.position >= 12 && p.position <= 15)
                                            .OrderBy(p => p.element_type == 1 ? 0 : 1)
                                            .ThenBy(p => p.position);
    }
    @foreach (var p in myBench)
    {
        <div class="bench-card" onclick="togglePoints(this)">
            <div class="jersey">
                <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@p.team_code-66.png" alt="@p.web_name" />
            </div>
            <div class="player-info">
                <span class="player-name">@p.web_name</span>
                <span class="player-points" data-event-points="@p.event_points" data-total-points="@p.total_points">
                    @p.event_points pts
                </span>
            </div>
        </div>
    }
</div>


@{
    int myGWPoints = Model.MyGameweekPoints;
    int opponentGWPoints = Model.OpponentGameweekPoints;

    int myTotalPoints = Model.Me.summary_overall_points ?? 0;
    int opponentTotalPoints = Model.Opponent.summary_overall_points ?? 0;
}

<div class="team-info my-info" onclick="toggleTeamPoints(this)">
    <h2>
        @Model.Me.player_first_name @Model.Me.player_last_name
    </h2>

    <h3>
        <span class="team-points"
              data-gw-points="@myGWPoints"
              data-total-points="@myTotalPoints">
            GW: @myGWPoints pts
        </span>
    </h3>
</div>

<div class="team-info opponent-info" onclick="toggleTeamPoints(this)">
    <h2>
        @Model.Opponent.player_first_name @Model.Opponent.player_last_name
    </h2>

    <h3>
        <span class="team-points"
              data-gw-points="@opponentGWPoints"
              data-total-points="@opponentTotalPoints">
            GW: @opponentGWPoints pts
        </span>
    </h3>
</div>

<script>
    function togglePoints(card) {
        var points = card.querySelector(".player-points");

        var eventPoints = points.getAttribute("data-event-points");
        var totalPoints = points.getAttribute("data-total-points");

        if (points.dataset.showing === "total") {
            points.textContent = eventPoints + " pts";
            points.dataset.showing = "event";
        }
        else {
            points.textContent = totalPoints + " pts";
            points.dataset.showing = "total";
        }
    }

    function toggleScoreboard(card) {
        var valueEl = card.querySelector("#scoreboardValue");
        var titleEl = card.querySelector("#scoreboardTitle");

        var totalDiff = parseInt(card.getAttribute("data-total-diff"));
        var gwDiff = parseInt(card.getAttribute("data-gw-diff"));

        var showingTotal = card.getAttribute("data-showing") === "total";
        var diff = showingTotal ? gwDiff : totalDiff;

        titleEl.textContent = showingTotal ? "Gameweek Difference" : "Points Difference";
        card.setAttribute("data-showing", showingTotal ? "gw" : "total");

        valueEl.className = "scoreboard-difference " + (diff > 0 ? "positive" : diff < 0 ? "negative" : "equal");

        if (diff > 0) {
            valueEl.innerHTML = "<span>↑ " + diff + "</span>";
        } else if (diff < 0) {
            valueEl.innerHTML = "<span>↓ " + Math.abs(diff) + "</span>";
        } else {
            valueEl.innerHTML = "<span>0</span>";
        }
    }
    function toggleTeamPoints(box) {
        var points = box.querySelector(".team-points");

        var gwPoints = points.getAttribute("data-gw-points");
        var totalPoints = points.getAttribute("data-total-points");

        if (points.dataset.showing === "total") {
            points.textContent = "GW: " + gwPoints + " pts";
            points.dataset.showing = "gw";
        }
        else {
            points.textContent = "Total: " + totalPoints + " pts";
            points.dataset.showing = "total";
        }
    }
</script>