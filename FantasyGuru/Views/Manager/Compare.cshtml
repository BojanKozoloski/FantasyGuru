@{
    int myPoints = Model.Me.summary_overall_points ?? 0;
    int opponentPoints = Model.Opponent.summary_overall_points ?? 0;
    int difference = myPoints - opponentPoints;
}

<div class="scoreboard">
    <div class="scoreboard-title">
        Points Difference
    </div>

    <div class="scoreboard-difference
        @(difference > 0 ? "positive" : difference < 0 ? "negative" : "equal")">

        @if (difference > 0)
        {
            <span>↑ @difference</span>
        }
        else if (difference < 0)
        {
            <span>↓ @Math.Abs(difference)</span>
        }
        else
        {
            <span>0</span>
        }

    </div>

    <div class="scoreboard-label">
        You vs Opponent
    </div>
</div>


<div class="pitch">
    <div class="team my-team">

        @{
            var myGroups = Model.MyUniquePlayers.GroupBy(p => p.element_type);
        }
        @foreach (var group in myGroups)
        {
            var playersInRow = group.ToList();
            var count = playersInRow.Count;

            for (int i = 0; i < count; i++)
            {

                var p = playersInRow[i];
                double topPercent = (104.0 / (count + 1)) * (i + 1);

                <div class="player position-@p.element_type" style="top:@topPercent%">

                    <div class="player-card">

                        <div class="jersey">

                            <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@p.team_code-66.png" alt="@p.web_name" />

                        </div>

                        <div class="player-info">
                            <span class="player-name">
                                @p.web_name
                            </span>

                            <span class="player-points">
                                @p.total_points pts
                            </span>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
    <div class="team opponent-team">

        @{
            var oppGroups = Model.OpponentUniquePlayers.GroupBy(p => p.element_type);
        }
        @foreach (var group in oppGroups)
        {
            var playersInRow = group.ToList();
            var count = playersInRow.Count;
            for (int i = 0; i < count; i++)
            {
                var p = playersInRow[i];
                double topPercent = (104.0 / (count + 1)) * (i + 1);
                <div class="player position-@p.element_type" style="top:@topPercent%">


                    <div class="player-card">

                        <div class="jersey">

                            <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@p.team_code-66.png" alt="@p.web_name" />

                        </div>

                        <div class="player-info">
                            <span class="player-name">
                                @p.web_name
                            </span>

                            <span class="player-points">
                                @p.total_points pts
                            </span>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</div>
