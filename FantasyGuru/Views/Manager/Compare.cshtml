@model FantasyGuru.Models.Compare
@{
    ViewBag.Title = "Compare";
    Layout = null;
}
<style>

    body {
        background-image: url('/Images/FantasyGurupitch.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .pitch {
        position: relative;
        width: 82vw;
        height: 90vh;
        margin: 20px auto;
        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
    }

    .pitch-header {
        display: flex;
        justify-content: space-between;
        padding: 0 10px;
        color: white;
        font-weight: bold;
    }

    .team {
        position: absolute;
        top: 30px;
        width: 50%;
        height: calc(100% - 40px);
    }


    /* Your team is on the LEFT */
    .my-team {
        left: 0;
    }


    /* Opponent is on the RIGHT */
    .opponent-team {
        right: 0;
    }


    /* Every player */
    .player {
        position: absolute;
        transform: translate(-50%, -50%);
        text-align: center;
        font-size: 14px;
        font-weight: bold;
        color: white;
        width: 80px;
    }

    .player-card {
        width: 80px;
        height: 110px;
        background: rgba(0, 0, 0, 0.65);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0,0,0,0.6);
        text-align: center;
        border: 1px solid rgba(255,255,255,0.2);
        transition: transform 0.2s ease, background 0.2s ease;
    }


    /* Jersey */
    .jersey {
        height: 75px;
        display: flex;
        justify-content: center;
        align-items: center;
    }


    /* Temporary jersey */
    .jersey-placeholder {
        font-size: 35px;
    }


    /* Player information */
    .player-info {
        height: 35px;
        background: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }


    /* Player name */
    .player-name {
        font-weight: bold;
        font-size: 10px;
        color: black;
    }


    /* Points */
    .player-points {
        font-size: 9px;
        color: black;
    }



    .my-team .position-1 {
        left: 5%;
    }


    /* DEF */
    .my-team .position-2 {
        left: 25%;
    }


    /* MID */
    .my-team .position-3 {
        left: 46%;
    }


    /* FWD */
    .my-team .position-4 {
        left: 66%;
    }
    /* GK */
    .opponent-team .position-1 {
        left: 93%;
    }


    /* DEF */
    .opponent-team .position-2 {
        left: 73%;
    }


    /* MID */
    .opponent-team .position-3 {
        left: 52%;
    }


    /* FWD */
    .opponent-team .position-4 {
        left: 32%;
    }

    .player-card:hover {
        transform: translateY(-5px);
        background: rgba(0, 0, 0, 0.85);
    }

    .jersey img {
        width: 50px;
        height: auto;
    }

    .captain {
        position: absolute;
        top: 3px;
        right: 3px;
        background: #00b86b;
        color: black;
        font-weight: bold;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        font-size: 10px;
        line-height: 16px;
    }


    .scoreboard {
        position: absolute;
        top: 20px;
        left: 49%;
        transform: translateX(-50%);
        width: 260px;
        padding: 12px 20px;
        background: rgba(0, 0, 0, 0.65);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
        text-align: center;
        color: white;
        z-index: 10;
    }

    .scoreboard-title {
        font-size: 13px;
        color: #00b86b;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .scoreboard-difference {
        font-size: 28px;
        font-weight: bold;
    }

    .scoreboard-label {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.7);
    }

    /* You have more points */
    .scoreboard-difference.positive {
        color: #00b86b;
    }

    /* Opponent has more points */
    .scoreboard-difference.negative {
        color: #e74c3c;
    }

    /* Same points */
    .scoreboard-difference.equal {
        color: orange;
    }
</style>

