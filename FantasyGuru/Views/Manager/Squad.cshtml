@model FantasyGuru.Models.Manager
@{
    ViewBag.Title = "Squad";
    Layout = null;
}
<style>
    body {
        margin: 0;
        overflow: hidden;
    }

    .Box {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2%;
        width: 100%;
    }

    .Choose {
        position: absolute;
        top: 5%;
        right: 3%;
        width: 15%;
        min-width: 180px;
        max-width: 220px;
        background: rgba(0, 0, 0, 0.65);
        padding: 2%;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        color: white;
        z-index: 20;
        box-sizing: border-box;
    }

        .Choose h3 {
            color: #00b86b;
            margin-top: 0;
        }

        .Choose select {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.65);
            color: white;
            font-size: 14px;
            cursor: pointer;
            box-sizing: border-box;
        }

            .Choose select:focus {
                outline: none;
            }

            .Choose select option {
                background: #222;
                color: white;
            }

    .pitch {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-image: url('/Images/FantasyGurupitch.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        container-type: inline-size;
    }

    .team {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .player-card {
        position: absolute;
        transform: translate(-50%, -50%);
        width: 5cqw; 
        height: 8cqw;
        background: rgba(0, 0, 0, 0.75);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
        text-align: center;
        cursor: pointer;
        transition: transform 0.15s ease;
    }

        .player-card:active {
            transform: translate(-50%, -50%) scale(0.95);
        }


    .jersey {
        height: 68%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .jersey-placeholder {
        font-size: 40px;
    }

    .player-info {
        height: 32%;
        background: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .player-name {
        font-weight: bold;
        font-size: 11px;
    }

    .player-points {
        font-size: 10px;
        margin-top: 1px;
    }

    .captain {
        position: absolute;
        top: 3%;
        right: 3%;
        background: #00b86b;
        color: black;
        font-weight: bold;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        font-size: 10px;
        line-height: 16px;
    }

    /* GK */
    .team .position-1 {
        left: 10%
    }

    /* DEF */
    .team .position-2 {
        left: 22%
    }

    /* MID */
    .team .position-3 {
        left: 35%
    }

    /* FWD */
    .team .position-4 {
        left: 48%;
    }

    .jersey img {
        width: 62%;
        height: auto;
    }


    .bench {
        position: absolute;
        bottom: 0.6cqw;
        left: 0.5cqw;
        display: flex;
        flex-direction: column;
        gap: 0.5cqw;
        width: 6cqw;
        height: 35cqw;
        background: rgba(0, 0, 0, 0.65);
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
        box-sizing: border-box;
        padding: 0.5cqw;
        
    }

        .bench h4 {
            color: white;
            width: 100%;
            margin: 0 0 4px 0;
        }

    .bench-card {
        width: 5cqw;
        height: 8cqw;
        aspect-ratio: 80 / 110;
        background: rgba(0, 0, 0, 0.75);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
        text-align: center;
        cursor: pointer;
        transition: transform 0.15s ease;
    }
        .bench-card:active {
            transform: scale(0.95);
        }

    .squad-info {
        position: absolute;
        top: 3%;
        left: 3%;
        width: 18%;
        background: rgba(0, 0, 0, 0.65);
        padding: 1.5% 2%;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        color: white;
        z-index: 10;
        cursor: pointer;
        transition: transform 0.15s ease;
        box-sizing: border-box;
    }

        .squad-info h1 {
            margin: 0 0 5px 0;
            color: #00b86b;
            font-size: 24px;
        }

        .squad-info h3 {
            margin: 0;
            color: white;
            font-size: 16px;
        }
   

        .squad-info:active {
            transform: scale(0.95);
        }


</style>
<script>
function goToLeague() {
    var leagueIndex = document.getElementById("league").value;
    var managerId = @Model.Id;
    window.location.href =
        "/Manager/LeagueC?managerId=" + managerId +
        "&leagueIndex=" + leagueIndex;
    }

    function togglePoints(card) {
        var points = card.querySelector(".player-points");

        var eventPoints = points.getAttribute("data-event-points");
        var totalPoints = points.getAttribute("data-total-points");

        if (points.dataset.showing === "total") {
            points.textContent = eventPoints + " pts";
            points.dataset.showing = "event";
        }
        else {
            points.textContent = totalPoints + " pts";
            points.dataset.showing = "total";
        }
    }
    function toggleSquadPoints(box) {
        var points = box.querySelector(".squad-points");

        var gwPoints = points.getAttribute("data-gw-points");
        var totalPoints = points.getAttribute("data-total-points");

        if (points.dataset.showing === "total") {
            points.textContent = "GW: " + gwPoints + " pts";
            points.dataset.showing = "gw";
        }
        else {
            points.textContent = "Total: " + totalPoints + " pts";
            points.dataset.showing = "total";
        }

    }
</script>

<div class="squad-info" onclick="toggleSquadPoints(this)">
    <h1>@Model.player_first_name @Model.player_last_name</h1>

    <h3>
        <span class="squad-points"
              data-gw-points="@(ViewBag.MyGameweekPoints ?? 0)"
              data-total-points="@(Model.summary_overall_points ?? 0)">
            GW: @(ViewBag.MyGameweekPoints ?? 0) pts
        </span>
    </h3>
</div>

<div class="Box">
    <div class="pitch">
        <div class="team">
            @{
                var starters = Model.Team.Where(p => p.position >= 1 && p.position <= 11);
                var myGroups = starters.GroupBy(p => p.element_type);
            }
            @foreach (var group in myGroups)
            {
                var playersInRow = group.ToList();
                var count = playersInRow.Count;
                for (int i = 0; i < count; i++)
                {
                    var p = playersInRow[i];
                    double topPercent = (100.0 / (count + 1)) * (i + 1);
                    <div class="player-card position-@p.element_type" style="top:@topPercent%" onclick="togglePoints(this)">
                        <div class="jersey">
                            <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@(p.team_code)-66.png" alt="@p.web_name" />
                        </div>
                        <div class="player-info">
                            <span class="player-name">@p.web_name</span>
                            @if (p.is_captain)
                            {
                                <span class="captain">C</span>
                            }
                            <span class="player-points"
                                  data-event-points="@p.event_points"
                                  data-total-points="@p.total_points">
                                @p.event_points pts

                            </span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="bench">
            <h4 style="text-align:center">Bench</h4>
            @{

                var bench = Model.Team.Where(p => p.position >= 12 && p.position <= 15)
                                          .OrderBy(p => p.element_type == 1 ? 0 : 1)
                                          .ThenBy(p => p.position);
            }
            @foreach (var p in bench)
            {
                <div class="bench-card" onclick="togglePoints(this)">
                    <div class="jersey">
                        <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@(p.team_code)-66.png" alt="@p.web_name" />
                    </div>
                    <div class="player-info">
                        <span class="player-name">@p.web_name</span>
                        <span class="player-points"
                              data-event-points="@p.event_points"
                              data-total-points="@p.total_points">
                            @p.event_points pts

                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="Choose">
        <h3>Select League</h3>
        @using (Html.BeginForm("League", "Manager", FormMethod.Get))
        {
            <select id="league" name="id" onchange="goToLeague()">
                <option value="" selected disabled>Choose a league</option>
                @{
                    int i = 0;
                    foreach (var liga in Model.leagues.classic)
                    {
                        <option value="@i">@liga.Name</option>
                        i++;
                    }
                }
            </select>
        }
    </div>

</div>