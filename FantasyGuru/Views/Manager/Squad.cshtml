@model FantasyGuru.Models.Manager
@{
    ViewBag.Title = "Squad";
    Layout = null;
}
<style>
    .Box {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 50px;
    }

    .Team {
        width: 60%;
    }

    .Choose {
        width: 30%;
    }

    body {
        background-image: url('/Images/FantasyGurupitch.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }
</style>
<script>
function goToLeague() {
    var leagueIndex = document.getElementById("league").value;
    var managerId = @Model.Id;

    

    window.location.href =
        "/Manager/LeagueC?managerId=" + managerId +
        "&leagueIndex=" + leagueIndex;
}
</script>


<h2>Squad</h2>
<h1>@Model.player_first_name @Model.player_last_name</h1>

<h3>
    Total points:@if (Model.summary_overall_points == null)
    {
        var points = 0;
        @points;
    }
    else

    {
        @Model.summary_overall_points;
    }
</h3>

<div class="Box">
    <div class="Team">
        <p>My team</p>
        @foreach (var group in Model.Team.GroupBy(player => player.element_type))
        {
            if (group.Key == 1)
            {
                <h3>Goalkeepers:</h3>
            }
            else if (group.Key == 2)
            {
                <h3>Defenders:</h3>
            }
            else if (group.Key == 3)
            {
                <h3>Midfielders:</h3>
            }
            else if (group.Key == 4)
            {
                <h3>Attackers:</h3>
            }

            <hr />

            foreach (var player in group)
            {
                <p>
                    @player.web_name,
                    @player.is_captain,
                    @player.position,
                    @player.total_points
                </p>
            }
        }
    </div>
    
    <div class="Choose">
        <h3>Select League</h3>
        @using (Html.BeginForm("League", "Manager", FormMethod.Get))
        {
            <select id="league" name="id" onchange="goToLeague()">

                <option value="" selected disabled>
                    Choose a league
                </option>
                @{
                    int i = 0;
                    foreach (var liga in Model.leagues.classic)
                    {

                        <option value="@i">
                            @liga.Name
                        </option>
                        i++;

                    }
                }
            </select>
        }

    </div>

</div>
