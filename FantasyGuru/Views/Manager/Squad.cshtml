@model FantasyGuru.Models.Manager
@{
    ViewBag.Title = "Squad";
    Layout = null;
}
<style>
    body {
        margin: 0;
        overflow: hidden;
        background-image: url('/Images/FantasyGurupitch.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .Box {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 50px;
    }

    .Choose {
        position: absolute;
        top: 400px;
        right: 600px;
        width: 220px;
        background: rgba(0, 0, 0, 0.65);
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        color: white;
        z-index: 10;
    }

        .Choose h3 {
            color: #00b86b;
            margin-top: 0;
        }

        .Choose select {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.65);
            color: white;
            font-size: 14px;
            cursor: pointer;
        }

            .Choose select:focus {
                outline: none;
            }

            .Choose select option {
                background: #222;
                color: white;
            }

    .pitch {
        position: relative;
        width: 60vw;
        height: 78vh;
        margin: 10px auto;
    }

    .team {
        position: absolute;
        top: 0;
        width: 100%;
        height: 100%;
    }

    .player-card {
        position: absolute;
        transform: translate(-50%, -50%);
        width: 80px;
        height: 110px;
        background: rgba(0, 0, 0, 0.75);
        
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
        text-align: center;
    }

    .jersey {
        height: 75px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .jersey-placeholder {
        font-size: 40px;
    }

    .player-info {
        height: 35px;
        background: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .player-name {
        font-weight: bold;
        font-size: 11px;
    }

    .player-points {
        font-size: 10px;
        margin-top: 1px;
    }

    .captain {
        position: absolute;
        top: 3px;
        right: 3px;
        background: #00b86b;
        color: black;
        font-weight: bold;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        font-size: 10px;
        line-height: 16px;
    }

    /* GK */
    .team .position-1 {
        left: -13%;
        
    }

    /* DEF */
    .team .position-2 {
        left: -2%;
    }

    /* MID */
    .team .position-3 {
        left: 18%;
    }

    /* FWD */
    .team .position-4 {
        left: 40%;
    }
    .jersey img {
        width: 50px;
        height: auto;
    }


    .bench {
        position: absolute;
        bottom: 30px;
        left: -375px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: rgba(0, 0, 0, 0.65);
        padding: 10px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5)
    }

        .bench h4 {
            color: white;
            width: 100%;
            margin: 0 0 4px 0;
        }

    .bench-card {
        width: 80px;
        height: 110px;
        background: rgba(0, 0, 0, 0.75);
        
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
        text-align: center;
    }

        .bench-card .jersey img {
            width: 50px;
            height: auto;
        }

        .bench-card .player-info {
            height: 25px;
        }

        .bench-card .player-name {
            font-size: 9px;
        }

        .bench-card .player-points {
            font-size: 8px;
        }
    .squad-info {
        position: absolute;
        top: 20px;
        left: 30px;
        background: rgba(0, 0, 0, 0.65);
        padding: 15px 25px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        color: white;
        z-index: 10;
    }

        .squad-info h1 {
            margin: 0 0 5px 0;
            color: #00b86b;
            font-size: 24px;
        }

        .squad-info h3 {
            margin: 0;
            color: white;
            font-size: 16px;
        }
</style>
<script>
function goToLeague() {
    var leagueIndex = document.getElementById("league").value;
    var managerId = @Model.Id;
    window.location.href =
        "/Manager/LeagueC?managerId=" + managerId +
        "&leagueIndex=" + leagueIndex;
}
</script>

<div class="squad-info">
    <h1>@Model.player_first_name @Model.player_last_name</h1>
    <h3>
        Total points:
        @if (Model.summary_overall_points == null)
        {
            var points = 0;
            @points;
        }
        else
        {
            @Model.summary_overall_points;
        }
    </h3>
</div>

<div class="Box">
    <div class="pitch">
        <div class="team">
            @{
                var starters = Model.Team.Where(p => p.position >= 1 && p.position <= 11);
                var myGroups = starters.GroupBy(p => p.element_type);
            }
            @foreach (var group in myGroups)
            {
                var playersInRow = group.ToList();
                var count = playersInRow.Count;
                for (int i = 0; i < count; i++)
                {
                    var p = playersInRow[i];
                    double topPercent = (125.0 / (count + 1)) * (i + 1);
                    <div class="player-card position-@p.element_type" style="top:@topPercent%">
                        <div class="jersey">
                            <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@(p.team_code)-66.png" alt="@p.web_name" />
                        </div>
                        <div class="player-info">
                            <span class="player-name">@p.web_name</span>
                            @if (p.is_captain)
                            {
                                <span class="captain">C</span>
                            }
                            <span class="player-points">@p.total_points pts</span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="bench">
            <h4 style="text-align:center">Bench</h4>
            @{

                var bench = Model.Team.Where(p => p.position >= 12 && p.position <= 15)
                                          .OrderBy(p => p.element_type == 1 ? 0 : 1)
                                          .ThenBy(p => p.position);
            }
            @foreach (var p in bench)
            {
                <div class="bench-card">
                    <div class="jersey">
                        <img src="https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_@(p.team_code)-66.png" alt="@p.web_name" />
                    </div>
                    <div class="player-info">
                        <span class="player-name">@p.web_name</span>
                        <span class="player-points">@p.total_points pts</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="Choose">
        <h3>Select League</h3>
        @using (Html.BeginForm("League", "Manager", FormMethod.Get))
        {
            <select id="league" name="id" onchange="goToLeague()">
                <option value="" selected disabled>Choose a league</option>
                @{
                    int i = 0;
                    foreach (var liga in Model.leagues.classic)
                    {
                        <option value="@i">@liga.Name</option>
                        i++;
                    }
                }
            </select>
        }
    </div>
   
</div>