@model FantasyGuru.Models.Manager
@{
    ViewBag.Title = "Guru";
    Layout = null;
}
<style>


    main {
        color: black;
    }

    body {
        margin: 0;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background-image: url('/Images/FantasyGurupitch.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }


    .container {
        width: 500px;
        padding: 30px;
        background: rgba(0, 0, 0, 0.65);
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        color: white;
    }

        .container h1 {
            text-align: center;
            margin-top: 0;
        }

        .container p {
            text-align: center;
        }
    /* Manager form */

    .manager-form {
        display: flex;
        width: 100%;
        margin-top: 20px;
    }
        /* Manager number button */

        .manager-form button {
            padding: 12px 20px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 10px 0 0 10px;
            background: rgba(255, 255, 255, 0.15);
            color: white;
            cursor: pointer;
            font-size: 16px;
        }

            .manager-form button:hover {
                background: rgba(255, 255, 255, 0.25);
            }
        /* ID input */

        .manager-form input {
            flex: 1;
            padding: 12px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-left: none;
            border-radius: 0 10px 10px 0;
            background: rgba(255, 255, 255, 0.9);
            color: black;
            font-size: 16px;
            outline: none;
        }

            .manager-form input:focus {
                border-color: white;
            }
</style>

<body>
    

    
    <div class="container"> <h1>FantasyGuru!</h1> 
    <p>Enter your FPL ID</p> 
    @using (Html.BeginForm("Squad", "Manager", FormMethod.Get, new { @class = "manager-form" }))
    {
        <button type="submit"> Manager number </button> 
        <input type="number" name="id" />
        } 
    </div>

</body>






